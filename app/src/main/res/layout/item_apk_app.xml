<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_select_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                tools:src="@drawable/ic_apk"
                android:contentDescription="App Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/black_1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="WhatsApp Messenger" />

                <TextView
                    android:id="@+id/tv_app_package"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textColor="@color/gray_2"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="com.whatsapp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_app_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/teal_200"
                        tools:text="v2.24.12.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textSize="11sp"
                        android:textColor="@color/gray_2" />

                    <TextView
                        android:id="@+id/tv_app_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/gray_1"
                        tools:text="68.4 MB" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/iv_menu_app"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/dots_vertical"
                app:tint="@color/gray_1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options" />

        </LinearLayout>

        <!-- Fast Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="end">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_extract_apk"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="12sp"
                android:background="@drawable/common_line_button_color_bg"
                android:textColor="@color/teal_200"
                android:text="@string/apk_extract_btn" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_send_barcode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="12sp"
                android:background="@drawable/common_line_button_color_bg"
                android:backgroundTint="@color/teal_200"
                android:textColor="@color/white"
                android:text="@string/apk_send_barcode" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
